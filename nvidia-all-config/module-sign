#!/usr/bin/env bash

# Stop the script at any encountered error
set -e

_sign_module() {
  local _signed_any=0 _failed=0
  local _required="${1:-false}"
  local _selected_kernel="${2:-}"
  local _module_root="/usr/lib/modules${_selected_kernel:+/${_selected_kernel}}"

  if ! find "${_module_root}" -type f -path '*/extramodules/nvidia*.ko*' -print -quit | grep -q .; then
    if [[ "${_required}" == true && -n "${_selected_kernel}" ]]; then
      echo "ERROR: module-sign: no installed NVIDIA modules found for ${_selected_kernel}." >&2
      return 1
    fi
    echo ":: module-sign: skipped — no installed NVIDIA modules found"
    return 0
  fi

  while IFS= read -r -d '' _kbuild; do
    local _kernel="${_kbuild%/build}"
    _kernel="${_kernel##*/}"
    local _modules="/usr/lib/modules/${_kernel}/extramodules"
    [[ -z "${_selected_kernel}" || "${_kernel}" == "${_selected_kernel}" ]] || continue
    [[ -d "${_modules}" ]] || continue
    if ! find "${_modules}" -maxdepth 1 -type f -name 'nvidia*.ko*' -print -quit | grep -q .; then
      continue
    fi
    local _file="${_kbuild}/scripts/sign-file"
    local _config="${_kbuild}/.config"

    if [[ ! -x "${_file}" ]] || [[ ! -r "${_config}" ]]; then
      echo ":: module-sign: skipped ${_kernel}: build metadata missing" >&2
      [[ "${_required}" != true ]] || _failed=1
      continue
    fi

    local _key
    _key=$(grep -Po 'CONFIG_MODULE_SIG_KEY="\K[^"]*' "${_config}" 2>/dev/null || true)
    [[ -n "${_key}" ]] || _key="certs/signing_key.pem"
    [[ "${_key}" =~ ^/ ]] || _key="${_kbuild}/${_key}"
    local _cert="${_kbuild}/certs/signing_key.x509"
    local _hash_algo
    _hash_algo=$(grep -Po 'CONFIG_MODULE_SIG_HASH="\K[^"]*' "${_config}" 2>/dev/null \
      || echo sha256)

    if [[ -n "${NVIDIA_TKG_MODULE_SIGN_KEY:-}" && -n "${NVIDIA_TKG_MODULE_SIGN_CERT:-}" ]]; then
      _key="${NVIDIA_TKG_MODULE_SIGN_KEY}"
      _cert="${NVIDIA_TKG_MODULE_SIGN_CERT}"
    elif [[ ! -r "${_key}" || ! -r "${_cert}" ]]; then
      local -a _fallback_pairs=(
        "/etc/pki/akmods/private/private_key.priv:/etc/pki/akmods/certs/public_key.der"
        "/var/lib/dkms/mok.key:/var/lib/dkms/mok.pub"
        "/var/lib/shim-signed/mok/MOK.priv:/var/lib/shim-signed/mok/MOK.der"
      )
      local _pair
      for _pair in "${_fallback_pairs[@]}"; do
        if [[ -r "${_pair%%:*}" && -r "${_pair#*:}" ]]; then
          _key="${_pair%%:*}"
          _cert="${_pair#*:}"
          break
        fi
      done
    fi

    if [[ ! -r "${_key}" ]] || [[ ! -r "${_cert}" ]]; then
      echo ":: module-sign: skipped ${_kernel}: signing key not readable" >&2
      [[ "${_required}" != true ]] || _failed=1
      continue
    fi

    local _changed=0

    while IFS= read -r -d '' _mod; do
      local _plain_mod="${_mod}" _compression=""

      case "${_mod}" in
        *.ko.zst)
          zstd -d --rm -f -q "${_mod}"
          _plain_mod="${_mod%.zst}"
          _compression="zst"
          ;;
        *.ko.xz)
          xz -d -f "${_mod}"
          _plain_mod="${_mod%.xz}"
          _compression="xz"
          ;;
        *.ko.gz)
          gzip -d -f "${_mod}"
          _plain_mod="${_mod%.gz}"
          _compression="gz"
          ;;
      esac

      "${_file}" "${_hash_algo}" "${_key}" "${_cert}" "${_plain_mod}"

      case "${_compression}" in
        zst) zstd -19 --rm -f -q "${_plain_mod}" ;;
        xz) xz -f "${_plain_mod}" ;;
        gz) gzip -n -f "${_plain_mod}" ;;
      esac

      _changed=1
      _signed_any=1
    done < <(find "${_modules}" -maxdepth 1 -type f \
      \( -name 'nvidia*.ko' -o -name 'nvidia*.ko.zst' -o -name 'nvidia*.ko.xz' -o -name 'nvidia*.ko.gz' \) \
      -print0)

    if (( _changed )); then
      depmod "${_kernel}"
    fi
  done < <(find -L /usr/lib/modules -mindepth 2 -maxdepth 2 -name build -print0)

  if [[ "${_required}" == true && "${_signed_any}" == 0 ]]; then
    echo "ERROR: module-sign: no NVIDIA modules could be signed." >&2
    return 1
  fi
  (( _failed == 0 )) || return 1

  if (( _signed_any == 0 )); then
    echo ":: module-sign: skipped — no installed NVIDIA modules found"
  fi
}

main() {
  case "${1:-}" in
    "")
      local _required=false
      if command -v mokutil >/dev/null 2>&1 && mokutil --sb-state 2>/dev/null | grep -Eqi 'secure[[:space:]]*boot[[:space:]]+enabled'; then
        _required=true
      fi
      _sign_module "${_required}"
      ;;
    --required)
      _sign_module true "${2:-}"
      ;;
    *)
      echo "Usage: module-sign [--required [kernel-version]]" >&2
      echo "  Signs installed NVIDIA kmod modules with the kernel/system signing key." >&2
      return 1
      ;;
  esac
}

main "$@"

