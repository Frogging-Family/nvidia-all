#!/bin/sh
set -e
DKMS_NAME=@DKMS_NAME@
DKMS_VERSION=@PKGVER@

if [ "$1" = remove ] || [ "$1" = upgrade ] || [ "$1" = deconfigure ]; then
  # No DKMS state can be removed when DKMS is unavailable.
  if ! command -v dkms >/dev/null 2>&1; then
    exit 0
  fi

  dkms_status=$(dkms status -m "$DKMS_NAME" -v "$DKMS_VERSION")
  if [ -n "$dkms_status" ]; then
    dkms remove -m "$DKMS_NAME" -v "$DKMS_VERSION" --all
  fi
fi
