#!/bin/sh
set -e
ldconfig
if command -v systemd-sysusers >/dev/null 2>&1; then
  systemd-sysusers nvidia-utils.conf
fi

@SERVICE_FUNCTIONS@

if [ "$1" = configure ]; then
  _nv_services_restore
  _nv_services_configure "${2:-}" @PKGVER@
elif [ "$1" = abort-remove ] || [ "$1" = abort-deconfigure ]; then
  _nv_services_restore
fi

if [ "$1" = configure ]; then
  if command -v update-initramfs >/dev/null 2>&1; then
    # -u alone activates the initramfs-tools dpkg trigger.
    update-initramfs -u
  elif command -v dracut >/dev/null 2>&1; then
    dracut --force
  fi
fi
if [ -d /run/systemd/system ]; then
  systemctl daemon-reload
fi
