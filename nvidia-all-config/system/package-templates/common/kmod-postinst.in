kernels=$(_nv_kernel_versions)
[ -n "$kernels" ] || { echo "ERROR: No selected NVIDIA kernels found." >&2; exit 1; }
for kver in $kernels; do
  [ -d "/lib/modules/$kver" ] || { echo "ERROR: Selected kernel $kver is missing." >&2; exit 1; }
  depmod -a "$kver"
done

@SECURE_BOOT@

for kver in $kernels; do
  _nv_refresh_initramfs "$kver"
done
if [ -d /run/systemd/system ]; then
  systemctl daemon-reload
fi
