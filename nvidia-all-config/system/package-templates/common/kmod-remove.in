if [ "${1:-0}" -eq 0 ]; then
  for kver in $(_nv_kernel_versions); do
    [ -d "/lib/modules/$kver" ] || continue
    if command -v depmod >/dev/null 2>&1 && ! depmod -a "$kver"; then
      echo "WARNING: Failed to update module dependencies for $kver." >&2
    fi
    if command -v dracut >/dev/null 2>&1 || command -v update-initramfs >/dev/null 2>&1; then
      if ! _nv_refresh_initramfs "$kver"; then
        echo "WARNING: Initramfs update failed for $kver after NVIDIA removal." >&2
      fi
    fi
  done
fi
