if [ "${1:-0}" -eq "1" ] && command -v grubby >/dev/null 2>&1; then
  if ! grubby --update-kernel=ALL --remove-args='nomodeset' --args='@DRACUTOPTS@'; then
    echo "ERROR: grubby failed. Check the errors above." >&2
    exit 1
  fi
fi
if command -v restorecon >/dev/null 2>&1; then
  for path in \
    /usr/lib/nvidia-tkg/* \
    /usr/lib/modprobe.d/*nvidia* \
    /usr/lib/modules-load.d/*nvidia* \
    /usr/lib/dracut/dracut.conf.d/*nvidia* \
    /usr/lib/modules/*/extramodules/nvidia*.ko*; do
    [ -e "$path" ] || continue
    if ! restorecon "$path"; then
      echo "ERROR: Failed to restore the SELinux context for $path." >&2
      exit 1
    fi
  done
fi
